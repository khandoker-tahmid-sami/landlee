# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Supabase (Project Settings -> API Keys)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# "service_role" key on older projects, "secret key" (sb_secret_...) on projects
# using the new API key system. Either way: server-side only, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Google Gemini API (free tier via Google AI Studio: https://aistudio.google.com/apikey)
# Used for job extraction and CV/cover letter writing.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

# Outbound email (SMTP) - used for deadline reminder emails.
# Works with Gmail (use an App Password), Resend SMTP, Mailgun SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Landlee <you@example.com>"

# How many days before a deadline to send a reminder (comma-separated allowed, e.g. "7,3,1")
DEADLINE_REMINDER_DAYS=7,3,1
